# The secrets the example configuration (sparkplug_connector/config/config.yaml) reads from the environment.
# Everything else (endpoints, workspace, client id, MQTT user) is written into the configuration file.
# Either pass them from the shell (docker run -e NAME: nothing on disk; README, Run it in Docker), or copy this file
# to connector.env, fill it in (docker run --env-file connector.env) and keep it out of git.

DATABRICKS_CLIENT_SECRET=<the service principal's OAuth secret>
SPARKPLUG_MQTT_PASSWORD=<the MQTT user's password>

# Optional: the encrypted credential store (${credential:...} in the config) and encrypted config values
# CONNECTOR_MASTER_PASSWORD=<a strong password>

# Optional: the web UI login (web_ui.authentication.enabled: true)
# OAUTH_CLIENT_ID=<OAuth app client id>
# OAUTH_CLIENT_SECRET=<its secret>
# SESSION_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(32))">

# The Docker health check's port, if web_ui.port isn't 8001
# CONNECTOR_HEALTH_PORT=8001

# Log files besides the console (default true; the Docker image sets false: docker logs only)
# CONNECTOR_LOG_FILES=true
