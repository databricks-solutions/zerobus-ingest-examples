# Copy this file to .env and fill in your values: cp config.example.env .env
# .env is gitignored. Never commit real credentials.

# Zerobus Ingest endpoint, with https://
#   AWS:   https://<workspace-id>.zerobus.<region>.cloud.databricks.com
#   Azure: https://<workspace-id>.zerobus.<region>.azuredatabricks.net
#   GCP:   https://<workspace-id>.zerobus.<region>.gcp.databricks.com
ZEROBUS_SERVER_ENDPOINT=https://<workspace-id>.zerobus.us-west-2.cloud.databricks.com

# Workspace URL, with https://. The sink uses it for OAuth tokens and to read the table schema.
DATABRICKS_WORKSPACE_URL=https://<workspace-url>

# Service principal OAuth credentials (application ID and secret).
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
