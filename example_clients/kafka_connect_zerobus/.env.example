# Copy to .env (git-ignored) and fill in. Never commit .env.
# Databricks workspace used for Zerobus and for the SQL warehouse (table service).
DATABRICKS_WORKSPACE_URL=https://<workspace-url>
ZEROBUS_SERVER_ENDPOINT=https://<workspace-id>.zerobus.<region>.<domain>
# Service principal with write access to the target tables and the dead-letter table.
DATABRICKS_CLIENT_ID=<service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<service-principal-client-secret>
# SQL warehouse ID (table service: DESCRIBE, and CREATE/ALTER when auto-create or evolution is on).
SQL_WAREHOUSE_ID=<warehouse-id>
# Used by tests/at_least_once_check.py (your own credentials: a personal access token, or the same service principal).
DATABRICKS_HOST=https://<workspace-url>
DATABRICKS_TOKEN=
