# Copy to .env and fill in your values: cp config.example.env .env
# .env is gitignored. Never commit real credentials.

# --- Local stack (read by docker compose and by scripts/setup.sh) ---

# Filament's secret key, 32 random bytes in base64: openssl rand -base64 32
# Keep it. Changing it later makes the secrets stored in Filament unreadable.
ENCRYPTION_KEY=<encryption-key>

# Password for the PostgreSQL user "filament", which owns Filament's datastore and the source database.
POSTGRES_PASSWORD=<postgres-password>

# Source DSN as the Filament worker sees it. Inside Compose, the host is the service name "postgres".
SOURCE_DSN=postgres://filament:<postgres-password>@postgres:5432/shop?sslmode=disable

# Optional prefix for the source and Delta table names. Leave empty for orders and payments.
TABLE_PREFIX=

# --- Databricks (Zerobus Ingest and Unity Catalog) ---

# Workspace URL, with https://. The sink uses it for OAuth tokens. Filament requires https.
DATABRICKS_WORKSPACE_URL=https://<workspace-url>

# Zerobus Ingest endpoint, without https://
#   AWS:   <workspace-id>.zerobus.<region>.cloud.databricks.com
#   Azure: <workspace-id>.zerobus.<region>.azuredatabricks.net
#   GCP:   <workspace-id>.zerobus.<region>.gcp.databricks.com
ZEROBUS_ENDPOINT=<workspace-id>.zerobus.<region>.cloud.databricks.com

# Service principal OAuth credentials (application ID and secret). The secret needs the all-apis scope.
DATABRICKS_CLIENT_ID=<service-principal-uuid>
DATABRICKS_CLIENT_SECRET=<client-secret>

# SQL warehouse the sink uses to check the target tables.
SQL_WAREHOUSE_ID=<warehouse-id>

# Unity Catalog location of the Delta tables: orders goes to TARGET_SCHEMA, payments to TARGET_CDC_SCHEMA.
# The docs suggest a schema of its own for the cdc_append table. Both can be the same schema here.
TARGET_CATALOG=<catalog>
TARGET_SCHEMA=<schema>
TARGET_CDC_SCHEMA=<cdc-schema>
