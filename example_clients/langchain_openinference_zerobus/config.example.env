# Copy to config.env and fill in. Never commit config.env.
# Service principal that the Collector uses to get OAuth tokens
DATABRICKS_CLIENT_ID=<service-principal-uuid>
DATABRICKS_CLIENT_SECRET=<service-principal-oauth-secret>
# Workspace and Zerobus Ingest endpoint, without https://
WORKSPACE_URL=<workspace-url>
WORKSPACE_ID=<workspace-id>
ZEROBUS_ENDPOINT=<workspace-id>.zerobus.<region>.cloud.databricks.com
# Unity Catalog location and the table prefix (the table is <prefix>_otel_spans)
CATALOG=<catalog>
SCHEMA=<schema>
TABLE_PREFIX=<prefix>
