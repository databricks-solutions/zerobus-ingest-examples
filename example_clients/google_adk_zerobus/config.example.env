# Copy to .env and fill in. Keep the client secret out of source control.
# Databricks workspace (use the URL shown in the workspace browser)
DATABRICKS_WORKSPACE_URL=https://<workspace-url>
DATABRICKS_CLIENT_ID=<service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<service-principal-oauth-secret>
WORKSPACE_ID=<workspace-id>
REGION=<region>
ZEROBUS_ENDPOINT=<workspace-id>.zerobus.<region>.cloud.databricks.com

# Target table, created from sql/create_otel_spans_table.sql
CATALOG=<catalog>
SCHEMA=<schema>
TABLE_PREFIX=<prefix>

# The agent app sends spans to the local Collector
OTEL_SERVICE_NAME=adk-dice-agent
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
