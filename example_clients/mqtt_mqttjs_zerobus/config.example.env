# Copy this file to config.env and fill in the values. Never commit config.env.
# Start the simulator with: npm start   (Node 20.6+ reads config.env with --env-file)

# Your workspace URL, for example https://<workspace-url>
DATABRICKS_WORKSPACE_URL=https://<workspace-url>
# Your workspace ID, used in the zerobusDirectWriteApi resource of the token request
DATABRICKS_WORKSPACE_ID=<workspace-id>
# Service principal application (client) ID and OAuth secret
DATABRICKS_CLIENT_ID=<service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<service-principal-client-secret>
# Target Unity Catalog table, three-level name
DATABRICKS_TABLE_NAME=<catalog>.<schema>.dice_rolls
# Zerobus Ingest MQTT hostname, without https://
ZEROBUS_MQTT_HOST=<workspace-id>.zerobus.<region>.<cloud-domain>

# Simulator settings (optional)
# Milliseconds between rolls
ROLL_INTERVAL_MS=1000
# Number of rolls to send, 0 keeps going until you press Ctrl+C
ROLL_COUNT=0
