# Copy this file to .env and fill in your values: cp config.example.env .env
# .env is gitignored. Never commit real credentials.

# Workspace URL, with https://. The callback gets its OAuth token from this host.
ZEROBUS_WORKSPACE_URL=https://<workspace-url>

# Zerobus Ingest endpoint, with https://
#   AWS:   https://<workspace-id>.zerobus.<region>.cloud.databricks.com
#   Azure: https://<workspace-id>.zerobus.<region>.azuredatabricks.net
#   GCP:   https://<workspace-id>.zerobus.<region>.gcp.databricks.com
ZEROBUS_SERVER_ENDPOINT=https://<workspace-id>.zerobus.<region>.cloud.databricks.com

# Service principal OAuth credentials (application ID and secret).
ZEROBUS_CLIENT_ID=
ZEROBUS_CLIENT_SECRET=

# Target table, three-part name. Create it with scripts/create_table.sh.
ZEROBUS_TABLE_NAME=<catalog>.<schema>.litellm_requests

# Gateway admin key for this demo. Any string that starts with sk-.
LITELLM_MASTER_KEY=sk-change-me
