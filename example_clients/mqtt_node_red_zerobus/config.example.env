# Copy to config.env (git-ignored) and fill in. Placeholders only: never commit real values.
# The flow reads every setting from these environment variables. Nothing secret is stored in flows.json.

# Workspace URL used for the OAuth token request (the normal https://<workspace-url>).
DATABRICKS_WORKSPACE_URL=https://<workspace-url>
# Numeric workspace ID, used in the token request resource.
DATABRICKS_WORKSPACE_ID=<workspace-id>
# Service principal (OAuth client credentials). Grant USE CATALOG, USE SCHEMA, SELECT and MODIFY on the table.
DATABRICKS_CLIENT_ID=<service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<service-principal-client-secret>
# Target Unity Catalog table, three-level name. Create it first; Zerobus Ingest doesn't create tables.
DATABRICKS_TABLE_NAME=<catalog>.<schema>.mqtt_node_red
# MQTT hostname of the Zerobus Ingest endpoint for your workspace (port 8883), without https://.
ZEROBUS_MQTT_HOST=<workspace-id>.zerobus.<region>.<cloud-domain>
# Host port for the Node-RED editor on 127.0.0.1 (any free high port).
PORT=48137
